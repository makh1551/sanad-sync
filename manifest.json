{
  "manifest_version": 3,
  "name": "مزامنة سند",
  "version": "1.10.1",
  "description": "تفتح التحضير الذكي ومنصة مدرستي في الخلفية وتجلب الغياب والدخول والخطة الأسبوعية إلى سند. إعداد: الفريق التقني بالمدرسة",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://s.tahdir.net/*",
    "https://schools.madrasati.sa/*",
    "https://taqweem.wasl.uk/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "مزامنة سند",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://schools.madrasati.sa/*"
      ],
      "js": [
        "nizam.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://taqweem.wasl.uk/*"
      ],
      "js": [
        "pair.js"
      ],
      "run_at": "document_idle"
    }
  ]
}