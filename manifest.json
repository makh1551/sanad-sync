{
  "manifest_version": 3,
  "name": "مزامنة سند",
  "version": "1.1.0",
  "description": "تجلب غياب الطلاب والمعلمين من التحضير الذكي، وتقارير نُظُم من مدرستي، إلى سند. إعداد: الفريق التقني بالمدرسة",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://s.tahdir.net/*",
    "https://taqweem.wasl.uk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "مزامنة سند",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://schools.madrasati.sa/*"
      ],
      "js": [
        "nizam.js"
      ],
      "run_at": "document_idle"
    }
  ]
}